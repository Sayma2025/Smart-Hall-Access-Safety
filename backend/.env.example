# ===================================================================
# Smart Hall Access & Safety Management System (SHASMS) - Environment
# ===================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas URI or local MongoDB)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/shasms_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shasms_db

# Security & Authentication
JWT_SECRET=shasms_university_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Hall Curfew Policies (24-hour format: HH:mm)
HALL_CURFEW_TIME=20:00
LATE_GRACE_PERIOD_MINUTES=15

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173
